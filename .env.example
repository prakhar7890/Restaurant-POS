# Optional Compose-only examples; native Windows development uses the
# process-scoped DATABASE_URL documented in docs/development.md.
# Never reuse development values outside a disposable local database.
POSTGRES_DB=restaurant_pos
POSTGRES_USER=pos_dev
POSTGRES_PASSWORD=local-only-change-me
POSTGRES_PORT=5433
API_PORT=8000
DATABASE_URL=postgresql+psycopg://pos_dev:local-only-change-me@db:5432/restaurant_pos
JWT_SECRET_KEY=development-only-secret-change-this-before-use-123456
POS_CORS_ORIGINS=http://localhost:1420,http://127.0.0.1:1420,http://localhost:8081,http://127.0.0.1:8081
POS_TRUSTED_HOSTS=localhost,127.0.0.1

# Frontend URLs. Use a LAN IP for a physical device and 10.0.2.2 for an Android emulator.
VITE_API_URL=http://127.0.0.1:8000
EXPO_PUBLIC_API_URL=http://127.0.0.1:8000
